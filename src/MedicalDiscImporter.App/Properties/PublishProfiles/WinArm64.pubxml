<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>ARM64</Platform>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <SignPublishedExecutable Condition="'$(SignPublishedExecutable)' == ''">true</SignPublishedExecutable>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishDir>D:\VisualStudio2\MedicalDiscImporter\artifacts\publish\win-arm64\</PublishDir>
    <PublishUrl>D:\VisualStudio2\MedicalDiscImporter\..\..\artifacts\publish\win-arm64\</PublishUrl>
    <PublishX64WithArm64 Condition="'$(PublishX64WithArm64)' == ''">true</PublishX64WithArm64>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>