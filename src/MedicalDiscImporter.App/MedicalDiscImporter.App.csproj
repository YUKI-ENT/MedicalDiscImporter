<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MedicalDiscImporter</AssemblyName>
    <RootNamespace>MedicalDiscImporter.App</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSigningThumbprint Condition="'$(PublishSigningThumbprint)' == ''">89AA6D9BABBAAE6672A34DE9F07E47359389ACF2</PublishSigningThumbprint>
    <PublishSigningTimestampUrl Condition="'$(PublishSigningTimestampUrl)' == ''">http://timestamp.digicert.com</PublishSigningTimestampUrl>
    <ApplicationIcon>..\..\assets\icon-proposals\A-disc-slices.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MedicalDiscImporter.Core\MedicalDiscImporter.Core.csproj" />
    <EmbeddedResource Include="..\..\assets\icon-proposals\A-disc-slices.ico" LogicalName="MedicalDiscImporter.App.Application.ico" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Sign the final single-file bundle, after publishing has completed. -->
  <Target Name="SignPublishedExecutable" AfterTargets="Publish"
          Condition="'$(SignPublishedExecutable)' == 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\Sign-PublishedExecutable.ps1&quot; -ExecutablePath &quot;$(PublishDir)$(AssemblyName).exe&quot; -CertificateThumbprint &quot;$(PublishSigningThumbprint)&quot; -PfxPath &quot;$(PublishSigningPfx)&quot; -TimestampUrl &quot;$(PublishSigningTimestampUrl)&quot;" />
  </Target>

  <!-- Use a separate dotnet process so ARM64 build properties do not leak into the x64 publish. -->
  <Target Name="PublishX64Companion" AfterTargets="Publish" DependsOnTargets="SignPublishedExecutable"
          Condition="'$(PublishX64WithArm64)' == 'true' and '$(RuntimeIdentifier)' == 'win-arm64'">
    <Message Importance="high" Text="ARM64版の発行完了。続けてx64版を発行します。" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          StdOutEncoding="utf-8" StdErrEncoding="utf-8"
          Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; --configuration &quot;$(Configuration)&quot; -p:PublishProfile=WinX64 -p:PublishX64WithArm64=false -p:SignPublishedExecutable=$(SignPublishedExecutable) -p:PublishSigningThumbprint=&quot;$(PublishSigningThumbprint)&quot; -p:PublishSigningPfx=&quot;$(PublishSigningPfx)&quot; -p:PublishSigningTimestampUrl=&quot;$(PublishSigningTimestampUrl)&quot; -p:ReleaseDate=$(ReleaseDate) -p:ReleaseRevision=$(_ReleaseRevisionNumber)" />
  </Target>

</Project>
